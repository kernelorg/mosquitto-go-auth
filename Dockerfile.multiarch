#
# Small multi-arch image (linux/amd64, linux/arm64, linux/arm/v7): Mosquitto 2.1
# built from source with TLS, built-in websockets and cJSON (dynamic security
# plugin / mosquitto_ctrl), plus the go-auth plugin, on top of the
# glibc distroless base (~20 MB). Everything is cross-compiled on the build
# platform and the runtime stage only copies files, so no QEMU/binfmt is needed.
#
#   ./build-image.sh linux/arm64 mosquitto-go-auth-radius:arm64
#
# GO_BUILD_TAGS=minimal (default) compiles only the files and radius backends,
# which keeps the plugin small; pass --build-arg GO_BUILD_TAGS= for every backend.
#
# Why glibc and not Alpine: musl cannot dlopen() Go c-shared libraries
# (golang/go#54805, initial-exec TLS), so the plugin only works on glibc.
#
# Layout: /usr/sbin/mosquitto, /mosquitto/go-auth.so, /mosquitto/config/
# (mosquitto.conf includes /mosquitto/config/conf.d, mount your own there).

ARG MOSQUITTO_VERSION=2.1.2
ARG GO_IMAGE=golang:1.26-bookworm
ARG BASE_IMAGE=gcr.io/distroless/base-debian12:latest

# ---------------------------------------------------------------------------
# 1. Toolchain for the target architecture and Mosquitto.
# ---------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS builder
ARG TARGETARCH
ARG MOSQUITTO_VERSION

RUN set -ex; \
    case "$TARGETARCH" in \
      amd64) deb_arch=amd64; extra="" ;; \
      arm64) deb_arch=arm64; extra="gcc-aarch64-linux-gnu g++-aarch64-linux-gnu libc6-dev-arm64-cross binutils-aarch64-linux-gnu" ;; \
      arm)   deb_arch=armhf; extra="gcc-arm-linux-gnueabihf g++-arm-linux-gnueabihf libc6-dev-armhf-cross binutils-arm-linux-gnueabihf" ;; \
      *) echo "unsupported TARGETARCH=$TARGETARCH" >&2; exit 1 ;; \
    esac; \
    [ "$deb_arch" = amd64 ] || dpkg --add-architecture "$deb_arch"; \
    apt-get update; \
    apt-get install -y --no-install-recommends wget build-essential \
        "libssl-dev:$deb_arch" "libcjson-dev:$deb_arch" $extra; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Mosquitto: broker, clients, mosquitto_ctrl and the dynamic-security plugin.
RUN set -ex; \
    case "$TARGETARCH" in arm64) cross="aarch64-linux-gnu-" ;; arm) cross="arm-linux-gnueabihf-" ;; *) cross="" ;; esac; \
    wget -qO mosquitto.tar.gz "https://mosquitto.org/files/source/mosquitto-${MOSQUITTO_VERSION}.tar.gz"; \
    mkdir mosquitto; \
    tar -xzf mosquitto.tar.gz --strip-components=1 -C mosquitto; \
    rm mosquitto.tar.gz; \
    mkdir -p /usr/local/include; \
    cp -r mosquitto/include/. /usr/local/include/; \
    # 2.1: websockets are built in (no libwebsockets), cJSON is mandatory;
    # sqlite persistence plugin, mosquitto_ctrl shell (libedit) and the HTTP
    # API (libmicrohttpd) are left out to keep the image small.
    opts="CROSS_COMPILE=$cross CC=gcc CXX=g++ AR=ar \
          WITH_TLS=yes WITH_WEBSOCKETS=yes WITH_SQLITE=no WITH_EDITLINE=no WITH_HTTP_API=no \
          WITH_SYSTEMD=no WITH_SRV=no WITH_DOCS=no WITH_GMOCK=no WITH_STRIP=yes \
          WITH_SHARED_LIBRARIES=yes WITH_STATIC_LIBRARIES=no"; \
    make -C mosquitto -j "$(nproc)" $opts; \
    # The top-level "install" stops at the sqlite plugin that was not built, so install the parts one by one.
    for d in libcommon lib client apps src plugins/dynamic-security; do \
        make -C "mosquitto/$d" install DESTDIR=/out $opts; \
    done; \
    test -x /out/usr/local/sbin/mosquitto; \
    test -x /out/usr/local/bin/mosquitto_pub; \
    test -e /out/usr/local/lib/libmosquitto.so.1; \
    test -e /out/usr/local/lib/mosquitto_dynamic_security.so; \
    rm -rf /out/usr/local/lib/pkgconfig /out/usr/local/include; \
    find /out -type f -o -type l | sort; \
    case "$TARGETARCH" in arm64) triplet=aarch64-linux-gnu ;; arm) triplet=arm-linux-gnueabihf ;; *) triplet=x86_64-linux-gnu ;; esac; \
    mkdir -p /out/lib; cp "/usr/lib/$triplet/libcjson.so.1" /out/lib/

# ---------------------------------------------------------------------------
# 2. Cross-compile the plugin.
# ---------------------------------------------------------------------------
WORKDIR /app
ARG GO_BUILD_TAGS=minimal

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ENV CGO_ENABLED=1 \
    CGO_CFLAGS="-I/usr/local/include -fPIC" \
    CGO_LDFLAGS="-shared -Wl,--unresolved-symbols=ignore-all"

RUN set -ex; \
    case "$TARGETARCH" in arm64) export CC=aarch64-linux-gnu-gcc ;; arm) export CC=arm-linux-gnueabihf-gcc GOARM=7 ;; esac; \
    # auth-plugin.c includes go-auth.h, generate it before building the package.
    GOARCH="$TARGETARCH" go tool cgo -objdir /tmp/cgo -exportheader go-auth.h go-auth.go; \
    GOARCH="$TARGETARCH" go build -buildvcs=false -trimpath -tags "$GO_BUILD_TAGS" -ldflags="-s -w" -buildmode=c-shared -o go-auth.so .; \
    ls -la go-auth.so

# ---------------------------------------------------------------------------
# 3. Runtime: distroless glibc base, only COPY, so no emulation is needed.
# ---------------------------------------------------------------------------
FROM ${BASE_IMAGE}

COPY --from=builder /out/usr/local/sbin/mosquitto /usr/sbin/mosquitto
COPY --from=builder /out/usr/local/lib/ /out/lib/ /usr/lib/
COPY --from=builder /out/usr/local/bin/ /usr/bin/
COPY --from=builder /app/go-auth.so /mosquitto/go-auth.so
COPY docker/mosquitto/ /mosquitto/config/

EXPOSE 1883 9001

ENTRYPOINT ["/usr/sbin/mosquitto", "-c", "/mosquitto/config/mosquitto.conf"]
